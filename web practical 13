<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>GreenLeaf Nursery</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    body { font-family: 'DM Sans', sans-serif; background: #f6faf3; color: #2d3a2e; }

    /* ── NAVBAR ── */
    .navbar { background: #ffffff; border-bottom: 2px solid #c8e6c9; }
    .navbar-brand { font-family: 'DM Serif Display', serif; font-size: 1.6rem; color: #2e7d32 !important; }
    .nav-link { color: #33691e !important; font-weight: 500; }
    .nav-link:hover { color: #1b5e20 !important; }

    /* ── HERO ── */
    .hero {
      background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 60%, #dcedc8 100%);
      padding: 80px 0 60px; text-align: center;
    }
    .hero h1 { font-family: 'DM Serif Display', serif; font-size: 3rem; color: #1b5e20; }
    .hero p  { font-size: 1.1rem; color: #558b2f; max-width: 500px; margin: 0 auto; }

 



   /* ── CARDS ── */
    .card { border: 1.5px solid #c8e6c9; border-radius: 16px;
            background: #fff; box-shadow: 0 4px 16px rgba(46,125,50,.08);
            transition: transform .2s; }
    .card:hover { transform: translateY(-6px); }
    .card-title { font-family: 'DM Serif Display', serif; color: #2e7d32; }
    .plant-icon { font-size: 3rem; }

    /* ── FORM SECTION ── */
    .form-section { background: #fff; border-radius: 18px;
                    padding: 38px; border: 1.5px solid #c8e6c9;
                    box-shadow: 0 4px 20px rgba(46,125,50,.07); }
    .form-section h3 { font-family: 'DM Serif Display', serif; color: #2e7d32; margin-bottom: 22px; }
    .form-control, .form-select { border-color: #a5d6a7; }
    .form-control:focus, .form-select:focus { border-color: #4caf50; box-shadow: 0 0 0 .2rem rgba(76,175,80,.2); }

    /* ── BUTTONS ── */
    .btn-success { background: #2e7d32; border-color: #2e7d32; font-weight: 600; }
    .btn-success:hover { background: #1b5e20; border-color: #1b5e20; }
    .btn-outline-success { border-color: #2e7d32; color: #2e7d32; font-weight: 600; }
    .btn-outline-success:hover { background: #2e7d32; color: #fff; }

    /* ── FOOTER ── */
    footer { background: #1b5e20; color: #c8e6c9; text-align: center; padding: 24px 0; margin-top: 60px; }
    footer a { color: #a5d6a7; text-decoration: none; }
  </style>
</head>
<body>

<!-- ════════════════════════════════════════
     1. NAVBAR  (with Dropdown)
════════════════════════════════════════ -->
<nav class="navbar navbar-expand-lg sticky-top">
  <div class="container">
    <a class="navbar-brand" href="#">🌿 GreenLeaf</a>
    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="#">Home</a></li>




        <!-- DROPDOWN -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Shop</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">🪴 Indoor Plants</a></li>
            <li><a class="dropdown-item" href="#">🌸 Flowering Plants</a></li>
            <li><a class="dropdown-item" href="#">🌵 Succulents & Cacti</a></li>
            <li><hr class="dropdown-divider"/></li>
            <li><a class="dropdown-item" href="#">🛒 All Products</a></li>
          </ul>
        </li>

        <li class="nav-item"><a class="nav-link" href="#">Care Tips</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
        <li class="nav-item ms-2">
          <a class="btn btn-success btn-sm px-3" href="#">🛒 Cart (0)</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<!-- ════════════════════════════════════════
     2. HERO SECTION
════════════════════════════════════════ -->
<section class="hero">
  <div class="container">
    <p class="text-success fw-semibold mb-1">🌱 Fresh arrivals every week</p>
    <h1>Bring Nature<br/>Into Your Home</h1>
    <p class="mt-3">Handpicked plants, pots & care kits delivered to your doorstep</p>
    <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
      <button class="btn btn-success btn-lg px-5"
              data-bs-toggle="modal" data-bs-target="#offerModal">
        🎁 Today's Offer
      </button>
      <a href="#shop" class="btn btn-outline-success btn-lg px-5">Browse Plants</a>
    </div>
  </div>
</section>
<!-- ════════════════════════════════════════
     3. BREADCRUMB
════════════════════════════════════════ -->

<div class="container mt-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="#" class="text-success">Home</a></li>
      <li class="breadcrumb-item"><a href="#" class="text-success">Shop</a></li>
      <li class="breadcrumb-item active text-muted">Indoor Plants</li>
    </ol>
  </nav>
</div>

<!-- ════════════════════════════════════════
     4. PLANT CARDS  (responsive grid)
     xs=12 | sm=6 | lg=4
════════════════════════════════════════ -->
<section id="shop">
<div class="container mt-2 mb-5">
  <h2 class="mb-1" style="font-family:'DM Serif Display',serif; color:#1b5e20">🌿 Featured Plants</h2>
  <p class="text-muted mb-4">Bestsellers loved by our customers</p>
  <div class="row g-4">

    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card p-4 h-100">
        <div class="plant-icon">🪴</div>
        <h5 class="card-title mt-2">Monstera Deliciosa</h5>
        <p class="text-muted small">A stunning tropical plant with split leaves. Perfect for bright, indirect light.</p>
        <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
          <span class="fw-bold text-success fs-5">₹349</span>
          <span class="badge bg-success">Best Seller</span>
        </div>
        <button class="btn btn-outline-success btn-sm mt-3 w-100">Add to Cart</button>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card p-4 h-100">
        <div class="plant-icon">🌵</div>
        <h5 class="card-title mt-2">Cactus Combo Pack</h5>
        <p class="text-muted small">Set of 3 mini cacti — low maintenance, great for desks and windowsills.</p>
        <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
          <span class="fw-bold text-success fs-5">₹199</span>
          <span class="badge bg-warning text-dark">Low Stock</span>
       

</div>
        <button class="btn btn-outline-success btn-sm mt-3 w-100">Add to Cart</button>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card p-4 h-100">
        <div class="plant-icon">🌸</div>
        <h5 class="card-title mt-2">Peace Lily</h5>
        <p class="text-muted small">Elegant white blooms and glossy leaves. Purifies indoor air naturally.</p>
        <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
          <span class="fw-bold text-success fs-5">₹279</span>
          <span class="badge bg-info text-dark">Air Purifier</span>
        </div>
        <button class="btn btn-outline-success btn-sm mt-3 w-100">Add to Cart</button>
      </div>
    </div>

  </div>
</div>
</section>
<!-- ════════════════════════════════════════
     5. ORDER / ENQUIRY FORM
     Two-column layout on md+
════════════════════════════════════════ -->
<div class="container mb-5">
  <div class="form-section">
    <h3>🛍️ Place a Custom Order</h3>
    <form>
      <div class="row g-3">

        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Your Name</label>
          <input type="text" class="form-control" placeholder="e.g. Priya Verma" required/>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Email Address</label>
          <input type="email" class="form-control" placeholder="you@example.com" required/>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Select Plant</label>
         

 <select class="form-select">
            <option value="">-- Choose a plant --</option>
            <option>Monstera Deliciosa</option>
            <option>Cactus Combo Pack</option>
            <option>Peace Lily</option>
            <option>Other / Custom</option>
          </select>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Delivery City</label>
          <input type="text" class="form-control" placeholder="e.g. Nagpur"/>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Quantity</label>
          <input type="number" class="form-control" placeholder="1" min="1"/>
        </div>

        <div class="col-12 col-md-6">
          <label class="form-label fw-semibold">Preferred Delivery Date</label>
          <input type="date" class="form-control"/>
        </div>

        <div class="col-12">
          <label class="form-label fw-semibold">Special Instructions</label>
          <textarea class="form-control" rows="3"
                    placeholder="Any special requests? e.g. gift wrapping, specific pot colour..."></textarea>
        </div>

        <div class="col-12">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="newsletter"/>
            <label class="form-check-label" for="newsletter">
              Subscribe to our newsletter for plant care tips 🌱
            </label>
          </div>
        </div>

        <div class="col-12">
          <button type="submit" class="btn btn-success px-5 fw-semibold">
            🛒 Submit Order
          </button>
        </div>
 </div>
 

  </form>
  </div>
</div>
<!-- ════════════════════════════════════════
     6. MODAL  — Today's Offer
════════════════════════════════════════ -->
<div class="modal fade" id="offerModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:2px solid #a5d6a7; border-radius:18px;">

      <div class="modal-header" style="background:#e8f5e9; border-bottom:1px solid #c8e6c9;">
        <h5 class="modal-title fw-bold" style="font-family:'DM Serif Display',serif; color:#2e7d32;">
          🎁 Today's Special Offer
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body text-center py-4">
        <div style="font-size:4rem">🌿</div>
        <h4 class="mt-2" style="font-family:'DM Serif Display',serif; color:#1b5e20;">
          Flat 20% OFF on all Indoor Plants!
        </h4>
        <p class="text-muted">Use code <strong class="text-success">GREEN20</strong> at checkout.</p>
        <p class="small text-muted">Valid today only. Min. order ₹299.</p>
        <ul class="list-unstyled text-start d-inline-block mt-2">
          <li>✅ Free delivery on orders above ₹499</li>
          <li>🪴 Buy 2 Get 1 on succulents</li>
          <li>🎀 Free gift wrapping this weekend</li>
        </ul>
      </div>

      <div class="modal-footer" style="border-top:1px solid #c8e6c9;">
        <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Maybe Later</button>
        <button class="btn btn-success px-4" data-bs-dismiss="modal">Shop Now 🛒</button>
      </div>

    </div>
  </div>
</div>



!-- ════════════════════════════════════════
     7. FOOTER
════════════════════════════════════════ -->
<footer>
  <p class="mb-1">🌿 <strong>GreenLeaf Nursery</strong> — Bringing nature closer to you</p>
  <p class="small mb-0" style="opacity:.75">
    © 2024 GreenLeaf &nbsp;|&nbsp;
    <a href="#">Privacy Policy</a> &nbsp;|&nbsp;
    <a href="#">Shipping Info</a>
  </p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
