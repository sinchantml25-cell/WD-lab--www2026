<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Lumina Studio</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    :root { --ink: #0d0d0d; --cream: #f5f0e8; --gold: #c9a84c; --muted: #6b6560; }
    * { margin: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--ink); }
    h1,h2,h3,.brand { font-family: 'Playfair Display', serif; }

    /* NAVBAR */
    .navbar { background: var(--ink) !important; padding: 1.1rem 2rem; }
    .navbar-brand { color: var(--gold) !important; font-size: 1.6rem; letter-spacing: 1px; }
    .nav-link { color: #ccc !important; font-size: .9rem; letter-spacing: .5px; transition: color .2s; }
    .nav-link:hover { color: var(--gold) !important; }
    .nav-cta { background: var(--gold); color: var(--ink) !important; border-radius: 2px; padding: 6px 18px !important; font-weight: 600; }

    /* CAROUSEL */
    .carousel { max-height: 520px; overflow: hidden; }
    .carousel-item { height: 520px; }
    .slide-bg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-size: cover; background-position: center; position: relative; }
    .slide-bg::before { content:''; position:absolute; inset:0; background: rgba(0,0,0,.52); }
    .slide-text { position: relative; z-index: 1; }
    .s1 { background-image: url('https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=1400&q=80'); }
    .s2 { background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?w=1400&q=80'); }
    .s3 { background-image: url('https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1400&q=80'); }
    .slide-text { text-align: center; color: #fff; padding: 2rem; }
    .slide-text h2 { font-size: clamp(2rem, 5vw, 3.5rem); color: var(--gold); margin-bottom: .5rem; }
    .slide-text p { font-size: 1.15rem; opacity: .8; max-width: 500px; margin: 0 auto 1.5rem; }
    .carousel-indicators [data-bs-target] { background-color: var(--gold); }

 





   /* CARDS SECTION */
    .section { padding: 5rem 0; }
    .section-title { font-size: 2.4rem; margin-bottom: .4rem; }
    .gold-line { width: 60px; height: 3px; background: var(--gold); margin: 0 auto 3rem; }
    .card { border: none; border-radius: 0; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,.07); transition: transform .3s, box-shadow .3s; overflow: hidden; }
    .card:hover { transform: translateY(-6px); box-shadow: 0 12px 32px rgba(0,0,0,.13); }
    .card-img-top { height: 210px; object-fit: cover; width: 100%; }
    .card-title { font-family: 'Playfair Display', serif; font-size: 1.25rem; }
    .card-text { color: var(--muted); font-size: .9rem; line-height: 1.7; }
    .btn-gold { background: var(--gold); color: var(--ink); border: none; border-radius: 2px; font-weight: 600; padding: 8px 22px; letter-spacing: .4px; transition: opacity .2s; }
    .btn-gold:hover { opacity: .85; color: var(--ink); }
    .btn-outline-ink { border: 2px solid var(--ink); color: var(--ink); border-radius: 2px; font-weight: 600; padding: 7px 20px; background: transparent; transition: all .2s; }
    .btn-outline-ink:hover { background: var(--ink); color: #fff; }

    /* STATS STRIP */
    .stats { background: var(--ink); color: #fff; padding: 3.5rem 0; }
    .stat-num { font-family: 'Playfair Display', serif; font-size: 2.8rem; color: var(--gold); }
    .stat-label { font-size: .85rem; opacity: .6; letter-spacing: 1px; text-transform: uppercase; }

    /* CTA BANNER */
    .cta-banner { background: linear-gradient(135deg, #c9a84c 0%, #e8c96e 100%); padding: 4.5rem 0; text-align: center; }
    .cta-banner h2 { font-size: 2.5rem; color: var(--ink); }
    .cta-banner p { color: rgba(0,0,0,.65); max-width: 480px; margin: .8rem auto 2rem; }

    /* FOOTER */
    footer { background: #0d0d0d; color: #888; padding: 3rem 0 1.5rem; }
    footer h6 { color: var(--gold); font-family: 'Playfair Display', serif; font-size: 1rem; margin-bottom: 1rem; }
    footer a { color: #888; text-decoration: none; font-size: .88rem; display: block; margin-bottom: .4rem; transition: color .2s; }
    footer a:hover { color: var(--gold); }
    .footer-bottom { border-top: 1px solid #222; margin-top: 2rem; padding-top: 1.2rem; font-size: .8rem; text-align: center; }
    .brand-footer { font-family: 'Playfair Display', serif; color: var(--gold); font-size: 1.4rem; }
  </style>
</head>
