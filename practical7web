<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile Page</title>

<style>

/* Page Background */
body{
    font-family: Arial, sans-serif;
    margin:0;
    background-color:#8e7cc3;
}

/* Navigation Bar */
.navbar{
    background-color:#333;
    padding:15px;
    text-align:center;
}

.navbar a{
    color:white;
    text-decoration:none;
    margin:0 20px;
    font-size:18px;
}

.navbar a:hover{
    color:yellow;
}

/* Main Layout */
.container{
    width:80%;
    margin:auto;
    margin-top:20px;
}

/* Profile Card */
.profile{
    background:#f4f4f4;
    padding:20px;
    border-radius:10px;
    border:3px solid #444;
    text-align:center;
}

/* Profile Image */
.profile img{
    width:200px;
    border-radius:50%;
    border:4px solid #333;
}

/* Headings */
h1{
    color:#d00000;
}

h2{
    color:#0044cc;
}

/* Section Styling */
.section{
    background:white;
    margin-top:20px;
    padding:15px;
    border-left:5px solid #333;
}

/* Footer */
.footer{
    background:#333;
    color:white;
    text-align:center;
    padding:10px;
    margin-top:20px;
}

</style>
</head>

<body>

<!-- Navigation Bar -->
<div class="navbar">
<a href="#">Home</a>
<a href="#">About</a>
<a href="#">Skills</a>
<a href="#">Contact</a>
</div>

<div class="container">

<!-- Profile Section -->
<div class="profile">
<img src="https://img.freepik.com/premium-vector/avatar-profile-icon-flat-style-female-user-profile-vector-illustration-isolated-background-women-profile-sign-business-concept_157943-38866.jpg" alt="Profile Image">

<h1>Sinchan Tambe</h1>
<p>Web Development Student</p>
</div>

<!-- About Section -->
<div class="section">
<h2>About Me</h2>
<p>
I am a passionate student learning web development. I enjoy creating websites
using HTML, CSS, and JavaScript and improving my programming skills.
</p>
</div>

<!-- Skills Section -->
<div class="section">
<h2>Skills</h2>
<ul>
<li>HTML</li>
<li>CSS</li>
<li>Python</li>
<li>JavaScript</li>
</ul>
</div>

<!-- Contact Section -->
<div class="section">
<h2>Contact</h2>
<p>Email: sinchant@example.com</p>
<p>Phone: +1234567890</p>
</div>

</div>

<!-- Footer -->
<div class="footer">
<p>© 2026 Profile Page</p>
</div>

</body>
</html>
